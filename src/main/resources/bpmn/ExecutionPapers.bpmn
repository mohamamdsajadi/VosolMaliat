      <bpmn:incoming>Flow_0pf5o1c</bpmn:incoming>
      <bpmn:outgoing>Flow_11dgpnv</bpmn:outgoing>
      <bpmn:outgoing>Flow_07fwfdh</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_0tajbqi" sourceRef="Activity_1ahtl92" targetRef="Gateway_1uchrac" />
    <bpmn:sequenceFlow id="Flow_0eioah5" name="امکان صدور وجود دارد" sourceRef="Gateway_1uchrac" targetRef="Activity_0rwz3ak">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=canIssue</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0k7613y" name="امکان صدور وجود ندارد" sourceRef="Gateway_1uchrac" targetRef="Activity_010iyzn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(canIssue)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
