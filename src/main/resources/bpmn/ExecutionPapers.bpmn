  <bpmn:category id="Category_0w0wgtw">
    <bpmn:categoryValue id="CategoryValue_018bccc" value="صدور برگ اجرا" />
  </bpmn:category>
  <bpmn:message id="Message_15qoj1t" name="" />
  <bpmn:message id="Message_1i8unl4" name="debt_paper_recieved">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=tbz_GatiNo" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_0blcya1">
    <bpmn:participant id="Participant_0zo8zrs" name="سامانه وصول و اجرا" processRef="Process_0rtbdc5" />
    <bpmn:group id="Group_1old2zo" categoryValueRef="CategoryValue_018bccc" />
    <bpmn:textAnnotation id="TextAnnotation_1gv1en8">
      <bpmn:text>اگر امکان صدور برگ اجرا برای یک بدهی براساس چند محدودیت وجود نداشته باشد، تاریخ رفع آخرین محدودیت اعلام می‌شود.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1sw91qh">
      <bpmn:text>دریافت شدن اطلاعات پرونده
و میزان بدهی از سامانه عملیاتی</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_08qtnyv" associationDirection="None" sourceRef="Activity_010iyzn" targetRef="TextAnnotation_1gv1en8" />
    <bpmn:association id="Association_1wly86j" associationDirection="None" sourceRef="Event_1dm1a0h" targetRef="TextAnnotation_1sw91qh" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0rtbdc5" name="ExecutionPapers" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:exclusiveGateway id="Gateway_1uchrac">
      <bpmn:incoming>Flow_0tajbqi</bpmn:incoming>
      <bpmn:outgoing>Flow_0eioah5</bpmn:outgoing>
      <bpmn:outgoing>Flow_0k7613y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_10ewku3">
      <bpmn:incoming>Flow_05tcjnl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Activity_1ahtl92" name="بررسی امکان صدور برگ اجرا (براساس محدودیت‌های اعمالی مدیر سامانه)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-issuance-possibility" retries="" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k4vjit</bpmn:incoming>
      <bpmn:outgoing>Flow_0tajbqi</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_0rwz3ak" name="صدور برگ اجرا با شناسه یکتا">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issue-execution-paper" retries="" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0eioah5</bpmn:incoming>
      <bpmn:outgoing>Flow_0pf5o1c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_010iyzn" name="ارسال پاسخ «عدم امکان صدور برگ اجرا»، نوع و تاریخ رفع محدودیت به سامانه عملیاتی">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inform_sanim_rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0k7613y</bpmn:incoming>
      <bpmn:outgoing>Flow_05tcjnl</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="Event_1dm1a0h">
      <bpmn:outgoing>Flow_0k4vjit</bpmn:outgoing>
    </bpmn:startEvent>
