  </bpmn:message>
  <bpmn:collaboration id="Collaboration_0blcya1">
    <bpmn:participant id="Participant_0zo8zrs" name="سامانه وصول و اجرا" processRef="Process_0rtbdc5" />
    <bpmn:group id="Group_1old2zo" categoryValueRef="CategoryValue_018bccc" />
    <bpmn:textAnnotation id="TextAnnotation_1gv1en8">
      <bpmn:text>اگر امکان صدور برگ اجرا برای یک بدهی براساس چند محدودیت وجود نداشته باشد، تاریخ رفع آخرین محدودیت اعلام می‌شود.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1sw91qh">
      <bpmn:text>دریافت شدن اطلاعات پرونده
و میزان بدهی از سامانه عملیاتی</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_08qtnyv" associationDirection="None" sourceRef="Activity_010iyzn" targetRef="TextAnnotation_1gv1en8" />
    <bpmn:association id="Association_1wly86j" associationDirection="None" sourceRef="Event_1dm1a0h" targetRef="TextAnnotation_1sw91qh" />
  </bpmn:collaboration>
